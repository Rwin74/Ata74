{
  "name": "roblox-local-launcher",
  "version": "1.6.0",
  "description": "Windows network diagnostics and GoodbyeDPI client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never && node scripts/sign-release.cjs",
    "release": "node scripts/publish-release.cjs",
    "configure:github": "node scripts/configure-github.cjs",
    "test": "node tests/updater.cjs && node tests/tools.cjs && node tests/main.cjs && node tests/security.cjs && node tests/utilities.cjs && node tests/next-tools.cjs",
    "sign:release": "node scripts/sign-release.cjs"
  },
  "build": {
    "appId": "com.roblox.locallauncher",
    "productName": "Roblox DPI Launcher",
    "directories": {
      "output": "dist-update"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "extraResources": [
      {
        "from": "core/",
        "to": "core/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "system-scripts/",
        "to": "system-scripts/",
        "filter": [
          "*.ps1"
        ]
      },
      {
        "from": "storage-worker.js",
        "to": "storage-worker.js"
      },
      {
        "from": "duplicate-worker.js",
        "to": "duplicate-worker.js"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "profiles.js",
      "index.html",
      "styles.css",
      "package.json",
      "updater.js",
      "update-config.json",
      "system-tools.js",
      "network-tools.js",
      "utilities.js",
      "update-security.js",
      "update-public-key.pem",
      "startup-manager.js"
    ],
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ata74-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rwin74",
        "repo": "Ata74",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "roblox",
    "proxy",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rwin74/Ata74.git"
  }
}