{
  "name": "roblox-local-launcher",
  "version": "1.3.0",
  "description": "Custom Local Launcher & Network Analyzer for Roblox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "configure:github": "node scripts/configure-github.cjs",
    "test": "node tests/updater.cjs"
  },
  "build": {
    "appId": "com.roblox.locallauncher",
    "productName": "Roblox DPI Launcher",
    "directories": {
      "output": "dist-update"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "extraResources": [
      {
        "from": "core/",
        "to": "core/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "profiles.js",
      "index.html",
      "styles.css",
      "package.json",
      "updater.js",
      "update-config.json"
    ],
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ata74-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rwin74",
        "repo": "Ata74",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "roblox",
    "proxy",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rwin74/Ata74.git"
  }
}